# Copy to .env.local. Nothing here is a secret - every value points at a
# container on this machine.
#
# Ports are namespaced into the 2xxxx range rather than using the defaults.
# Three sibling projects share this machine and each one wanted 5432; a
# namespaced port fails loudly at bind time instead of silently connecting the
# API to the neighbour's database.

# --- devstack ports (read by docker-compose.yml and check.sh) ---
POSTGRES_PORT=25432
REDIS_PORT=26379
VERDACCIO_PORT=24873
LOCALSTACK_PORT=24566
LOCALSTRIPE_PORT=28420
MAILPIT_SMTP_PORT=21025
MAILPIT_UI_PORT=28025
CADDY_HTTP_PORT=20080
CADDY_HTTPS_PORT=20443

# --- runtime ---
NODE_ENV=development
APP_VERSION=0.0.0
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173

# 127.0.0.1 over localhost: Node 22 resolves localhost to ::1 first, and every
# container above publishes on IPv4 only. The browser follows the same host for
# a second reason - the refresh cookie is SameSite=Lax, so a page served from
# localhost:5173 calling 127.0.0.1:3000 is cross-site and never sends it.
DATABASE_URL=postgres://vpn_app:vpn_app_dev@127.0.0.1:25432/poc_vpn_dev
DATABASE_MIGRATION_URL=postgres://vpn_migrator:vpn_migrator_dev@127.0.0.1:25432/poc_vpn_dev

# --- auth ---
# Dev-only values. Production reads these from AWS Secrets Manager.
AUTH_JWT_SECRET=dev-access-secret-change-me-0000000000
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_PASSWORD_RESET_TTL=3600
AUTH_EMAIL_VERIFICATION_TTL=86400

# --- adapters: which implementation the port resolves to ---
CACHE_DRIVER=redis          # redis | memory
EMAIL_DRIVER=smtp           # smtp | memory
SMS_DRIVER=console          # console | memory
BILLING_DRIVER=stripe       # stripe | memory
STORAGE_DRIVER=s3           # s3 | memory

REDIS_URL=redis://127.0.0.1:26379

SMTP_HOST=127.0.0.1
SMTP_PORT=21025
EMAIL_FROM="poc-vpn <no-reply@poc-vpn.local>"

# localstripe accepts any sk_test_* key and signs webhooks with this secret.
STRIPE_API_KEY=sk_test_local
STRIPE_API_BASE=http://127.0.0.1:28420
STRIPE_WEBHOOK_SECRET=whsec_local
STRIPE_PRICE_ID=price_local_monthly

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:24566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=poc-vpn-assets

# --- observability ---
# Empty DSN selects the noop reporter. Set it to exercise the Sentry adapter.
SENTRY_DSN=
LOG_LEVEL=debug

# --- web (apps/web/.env.local) ---
VITE_API_URL=http://127.0.0.1:3000
VITE_SENTRY_DSN=
