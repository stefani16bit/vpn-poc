# Copy to .env.local. Nothing here is a secret - every value points at a
# container on this machine.
#
# Ports are namespaced into the 2xxxx range rather than using the defaults.
# Three sibling projects share this machine and each one wanted 5432; a
# namespaced port fails loudly at bind time instead of silently connecting the
# API to the neighbour's database.

# --- devstack ports (read by docker-compose.yml and check.sh) ---
POSTGRES_PORT=25432
REDIS_PORT=26379
VERDACCIO_PORT=24873
LOCALSTACK_PORT=24566
LOCALSTRIPE_PORT=28420
MAILPIT_SMTP_PORT=21025
MAILPIT_UI_PORT=28025
CADDY_HTTP_PORT=20080
CADDY_HTTPS_PORT=20443
# One pair per demonstrated region. The tunnel port and the control port travel
# together: a node is the two of them plus a key, and half a node registered is
# a region that accepts keys nobody can connect with.
WIREGUARD_PORT_SA=21820
EXIT_NODE_API_PORT_SA=21821
WIREGUARD_PORT_NA=21830
EXIT_NODE_API_PORT_NA=21831
WIREGUARD_PORT_EU=21840
EXIT_NODE_API_PORT_EU=21841
WIREGUARD_PORT_AS=21850
EXIT_NODE_API_PORT_AS=21851
WIREGUARD_PORT_AF=21860
EXIT_NODE_API_PORT_AF=21861

# --- runtime ---
NODE_ENV=development
APP_VERSION=0.0.0
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173

# 127.0.0.1 over localhost: Node 22 resolves localhost to ::1 first, and every
# container above publishes on IPv4 only. The browser follows the same host for
# a second reason - the refresh cookie is SameSite=Lax, so a page served from
# localhost:5173 calling 127.0.0.1:3000 is cross-site and never sends it.
DATABASE_URL=postgres://vpn_app:vpn_app_dev@127.0.0.1:25432/poc_vpn_dev
DATABASE_MIGRATION_URL=postgres://vpn_migrator:vpn_migrator_dev@127.0.0.1:25432/poc_vpn_dev

# --- auth ---
# Dev-only values. Production reads these from AWS Secrets Manager.
AUTH_JWT_SECRET=dev-access-secret-change-me-0000000000
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_PASSWORD_RESET_TTL=3600
AUTH_EMAIL_VERIFICATION_TTL=86400

# --- adapters: which implementation the port resolves to ---
CACHE_DRIVER=redis          # redis | memory
EMAIL_DRIVER=smtp           # smtp | memory
SMS_DRIVER=console          # console | memory
BILLING_DRIVER=memory       # stripe | memory — ver o bloco de cobrança abaixo
STORAGE_DRIVER=s3           # s3 | memory
QUEUE_DRIVER=sqs            # sqs | memory
SECRETS_DRIVER=aws          # aws | memory
EXIT_NODE_DRIVER=http       # http | memory
EXIT_NODE_API_URL=http://127.0.0.1:21821
# The credential each control plane demands — one per node, because a token the
# whole fleet shares cannot be rotated without dropping every node at once. A
# committed fixture, in the same category as vpn_app_dev in 01-roles.sql: each is
# worth exactly one local container. The region slug is inside the value so a
# failing assertion names which token ended up where.
#
# These reach the node through docker-compose.yml and reach the API through
# Secrets Manager, seeded from the same interpolation. check.sh proves both.
EXIT_NODE_API_TOKEN_SA=exit_node_dev_sa_1f4a9c2e8b7d6053a1c9e4f2b8d7a601
EXIT_NODE_API_TOKEN_NA=exit_node_dev_na_7c2e91b4f8a6d3095e1b7c4a2f8d6053
EXIT_NODE_API_TOKEN_EU=exit_node_dev_eu_3b8d1f6a4c9e2705d8b3a1f6c4e97052
EXIT_NODE_API_TOKEN_AS=exit_node_dev_as_9e4c7a2f1b8d6503c9a4e7b2f1d86045
EXIT_NODE_API_TOKEN_AF=exit_node_dev_af_5d1a8f3c6b9e2074a5d1c8f3b6e29047
EXIT_NODE_ENDPOINT=127.0.0.1:21820
EXIT_NODE_TUNNEL_CIDR=10.13.13.0/24
# What the downloaded .conf routes **on top of** the node's own range, which the
# fleet adds per node. A real deployment sets 0.0.0.0/0; locally it stays narrow,
# because a full tunnel here fights the host default route. The one range here is
# the canary's, and it is what makes a tunnel reach a private resource rather
# than only the node itself — every region routes it, and only the region whose
# node has a foot in that network gets an answer. DEC-075.
EXIT_NODE_CLIENT_ALLOWED_IPS=172.30.13.0/24

REDIS_URL=redis://127.0.0.1:26379

SMTP_HOST=127.0.0.1
SMTP_PORT=21025
EMAIL_FROM="poc-vpn <no-reply@poc-vpn.local>"

# Cobrança. O padrão é `memory`, e o motivo é a DEC-009: nenhum mock que subimos
# implementa /v1/checkout/sessions, então com `stripe` apontado para o
# localstripe o botão de assinar só pode falhar — e o boot recusa essa
# combinação em voz alta. Para exercitar cobrança de verdade, use o Stripe em
# test mode com a CLI; a receita está em docs/06-AMBIENTE-LOCAL.md.
#
# BILLING_DRIVER=stripe
# STRIPE_API_KEY=sk_test_...            # do seu dashboard, test mode
# STRIPE_WEBHOOK_SECRET=whsec_...       # o que `stripe listen` imprime
# STRIPE_PRICE_ID / _YEARLY             # `pnpm billing:prices` cria e imprime
#
# STRIPE_API_BASE só existe para o mock, e a suíte de integração dos adapters o
# alcança sem esta variável. Com BILLING_DRIVER=stripe ela é recusada no boot.

# Com o driver `memory` estes dois ids não vão a lugar nenhum: o fake os devolve
# na URL de checkout, e é por eles que o e2e prova a escolha mensal/anual.
STRIPE_PRICE_ID=price_local_monthly
STRIPE_PRICE_ID_YEARLY=price_local_yearly

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:24566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=poc-vpn-assets
QUEUE_URL=http://127.0.0.1:24566/000000000000/poc-vpn-notifications

# --- observability ---
# Empty DSN selects the noop reporter. Set it to exercise the Sentry adapter.
SENTRY_DSN=
LOG_LEVEL=debug

# Where the log lines go. Unset means pretty in development, json elsewhere.
#   pretty  colorised stdout + logs/api.ndjson, which `pnpm logs:trace` reads
#   json    NDJSON on stdout, nothing else - the Lambda/CloudWatch shape
#   file    logs/api.ndjson only
#   gelf    reserved for a Graylog-shaped sink; falls back to json today
#   loki    reserved for a Loki-shaped sink; falls back to json today
LOG_TRANSPORT=pretty
# LOG_TRANSPORT_URL=http://127.0.0.1:12201

# --- web (apps/web/.env.local) ---
VITE_API_URL=http://127.0.0.1:3000
VITE_SENTRY_DSN=
