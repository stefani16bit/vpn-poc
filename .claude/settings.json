{
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm --filter *:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm install)",
      "Bash(make check)",
      "Bash(make up)",
      "Bash(make ps)",
      "Bash(sh devstack/check.sh)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-test-focus.mjs"
          }
        ]
      }
    ]
  }
}
