  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.1.1",
    "@vpn-poc/adapters": "workspace:*",
    "@vpn-poc/database": "workspace:*",
    "@vpn-poc/env": "workspace:*",
    "@vpn/contracts": "^0.23.0",
    "@vpn/i18n": "^0.26.0",
    "@vpn/ports": "^0.15.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^5.2.1",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
